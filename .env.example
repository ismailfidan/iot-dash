# Sunucu Ayarları
PORT=3004
NODE_ENV=development

# Güvenlik - Üretim ortamında mutlaka güçlü rastgele değerlerle değiştirin!
# Örnek üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=degistir-guclu-bir-session-secret-anahtari-kullanin
ADMIN_USER=admin
# Varsayılan geliştirme şifresi: admin1234 (Üretimde değiştirin)
ADMIN_PASSWORD=admin1234

# ESP32 Ana Merkez (Gelecek Senkronizasyon) Kimlik Doğrulama Anahtarı
HUB_AUTH_TOKEN=degistir-esp32-ana-merkez-bearer-token
HUB_HMAC_SECRET=degistir-esp32-hmac-imza-anahtari

# CORS / Origin Güvenliği (virgülle ayrılmış izinli originler, boşsa sadece aynı host)
ALLOWED_ORIGINS=http://localhost:3004,http://127.0.0.1:3004
